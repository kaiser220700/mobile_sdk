{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "0.1.0",
  "package": "mobile_ui_kit",
  "usage": "The id is the stable cross-platform key. HTML uses html, while Flutter uses flutterWidget.",
  "components": [
    {"id":"alert-banner","category":"feedback","html":"<div role=\"alert\">","flutterWidget":"UiKitAlertBanner","states":["neutral","info","success","warning","error"]},
    {"id":"file-attachment","category":"data","html":"<article data-file>...</article>","flutterWidget":"UiKitFileAttachmentTile","states":["open","download","delete"]},
    {"id":"avatar","category":"foundation","html":"<img alt=\"...\">","flutterWidget":"UiKitAvatar","states":["sizes","status","ring"]},
    {"id":"avatar-stack","category":"layout","html":"<div class=\"avatar-stack\">...</div>","flutterWidget":"UiKitAvatarStack","states":["overlap","max-visible","overflow"]},
    {"id":"badge","category":"feedback","html":"<span>...</span>","flutterWidget":"UiKitBadge","states":["solid","soft","outline","dot"]},
    {"id":"status-pill","category":"feedback","html":"<span data-status>...</span>","flutterWidget":"UiKitBadge","states":["text","text-icon","icon","semantic"]},
    {"id":"button","category":"actions","html":"<button type=\"button\">...</button>","flutterWidget":"UiKitButton","states":["primary","outline","ghost","danger","success","disabled","loading"]},
    {"id":"card-shell","category":"layout","html":"<section>...</section>","flutterWidget":"UiKitCardShell","states":["border","shadow"]},
    {"id":"dashed-border","category":"layout","html":"<div class=\"dashed-border\">...</div>","flutterWidget":"UiKitDashedBorder","states":["radius","dash","gap"]},
    {"id":"checkbox","category":"forms","html":"<input type=\"checkbox\">","flutterWidget":"UiKitCheckbox","states":["checked","unchecked","indeterminate","disabled","error"]},
    {"id":"select-field","category":"forms","html":"<select>...</select>","flutterWidget":"UiKitSelectField","states":["placeholder","selected","open","disabled","error"]},
    {"id":"filter-chip","category":"forms","html":"<button role=\"checkbox\">...</button>","flutterWidget":"UiKitFilterChip","states":["selected","unselected","disabled","icon"]},
    {"id":"async-suggestion-field","category":"forms","html":"<input list=\"suggestions\">","flutterWidget":"UiKitAsyncSuggestionField","states":["query","results","selected","error"]},
    {"id":"media-picker","category":"forms","html":"<input type=\"file\" accept=\"image/*\">","flutterWidget":"UiKitMediaPicker","states":["empty","preview","uploading","error"]},
    {"id":"dialog","category":"feedback","html":"<dialog>...</dialog>","flutterWidget":"UiKitDialog","states":["info","success","warning","error"]},
    {"id":"divider","category":"layout","html":"<hr>","flutterWidget":"UiKitDivider","states":["horizontal","vertical"]},
    {"id":"icon","category":"foundation","html":"<svg aria-hidden=\"true\">...</svg>","flutterWidget":"UiKitIcon","states":["sizes","semantic-colors"]},
    {"id":"item","category":"navigation","html":"<button class=\"item\">...</button>","flutterWidget":"UiKitItem","states":["enabled","disabled","destructive"]},
    {"id":"list-item","category":"navigation","html":"<li>...</li>","flutterWidget":"UiKitListItem","states":["selected","disabled","divider"]},
    {"id":"list-entrance","category":"motion","html":"<li data-enter>...</li>","flutterWidget":"UiKitListEntrance","states":["animated","static","stagger"]},
    {"id":"fade-motion","category":"motion","html":"<div data-enter>...</div>","flutterWidget":"UiKitFadeMotion","states":["shown","hidden","directions"]},
    {"id":"bouncing-motion","category":"motion","html":"<div data-bounce>...</div>","flutterWidget":"UiKitBouncingMotion","states":["enabled","disabled"]},
    {"id":"shimmer","category":"motion","html":"<div aria-busy=\"true\">...</div>","flutterWidget":"UiKitShimmer","states":["enabled","disabled"]},
    {"id":"flip-counter","category":"motion","html":"<output>...</output>","flutterWidget":"UiKitFlipCounter","states":["value-change"]},
    {"id":"countdown","category":"motion","html":"<time>...</time>","flutterWidget":"UiKitCountdown","states":["running","paused","complete"]},
    {"id":"accordion","category":"disclosure","html":"<details><summary>...</summary></details>","flutterWidget":"UiKitAccordion","states":["expanded","collapsed","disabled"]},
    {"id":"loading-overlay","category":"feedback","html":"<div aria-busy=\"true\">...</div>","flutterWidget":"UiKitLoadingOverlay","states":["spinner","success","error","hidden"]},
    {"id":"otp-field","category":"forms","html":"<input inputmode=\"numeric\" autocomplete=\"one-time-code\">","flutterWidget":"UiKitOtpField","states":["empty","partial","complete","masked"]},
    {"id":"anchored-overlay","category":"overlay","html":"<div popover>...</div>","flutterWidget":"UiKitAnchoredOverlay","states":["open","closed","barrier-dismiss"]},
    {"id":"pressable","category":"interaction","html":"<button>...</button>","flutterWidget":"UiKitPressable","states":["hovered","pressed","selected","disabled"]},
    {"id":"progress","category":"feedback","html":"<progress value=\"62\" max=\"100\"></progress>","flutterWidget":"UiKitDeterminateProgress","states":["0","62","100"]},
    {"id":"radio","category":"forms","html":"<input type=\"radio\">","flutterWidget":"UiKitRadio","states":["selected","unselected","disabled"]},
    {"id":"search","category":"forms","html":"<input type=\"search\">","flutterWidget":"UiKitSearch","states":["empty","filled","disabled","cancel"]},
    {"id":"stat-tile","category":"data","html":"<article data-stat>...</article>","flutterWidget":"UiKitStatTile","states":["value","trend-up","trend-down","tap"]},
    {"id":"key-value","category":"data","html":"<dl><dt>...</dt><dd>...</dd></dl>","flutterWidget":"UiKitKeyValue","states":["normal","compact","copy"]},
    {"id":"skeleton","category":"feedback","html":"<div aria-busy=\"true\">...</div>","flutterWidget":"UiKitSkeleton","states":["enabled","disabled"]},
    {"id":"switch","category":"forms","html":"<input type=\"checkbox\" role=\"switch\">","flutterWidget":"UiKitSwitch","states":["on","off","disabled"]},
    {"id":"tabs","category":"navigation","html":"<div role=\"tablist\">...</div>","flutterWidget":"UiKitTabs","states":["underline","pill","active","disabled"]},
    {"id":"text-field","category":"forms","html":"<input>...</input>","flutterWidget":"UiKitTextField","states":["normal","success","error","password","textarea"]},
    {"id":"timeline","category":"data","html":"<ol data-timeline>...</ol>","flutterWidget":"UiKitTimeline","states":["completed","current","upcoming","error"]},
    {"id":"stepper","category":"navigation","html":"<ol data-stepper>...</ol>","flutterWidget":"UiKitStepper","states":["completed","current","upcoming","disabled"]},
    {"id":"quantity-stepper","category":"forms","html":"<input type=\"number\">","flutterWidget":"UiKitQuantityStepper","states":["min","max","disabled"]},
    {"id":"title","category":"typography","html":"<h2>...</h2>","flutterWidget":"UiKitTitle","states":["sizes","required","description"]},
    {"id":"toast-overlay","category":"feedback","html":"<div role=\"status\">...</div>","flutterWidget":"UiKitToastOverlay","states":["normal","success","warning","error"]},
    {"id":"tooltip","category":"overlay","html":"<div role=\"tooltip\">...</div>","flutterWidget":"UiKitTooltip","states":["hidden","visible","long-press"]}
  ]
}
